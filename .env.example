# Copiar a .env.dev para ejecutar con `go run` contra el postgres y rabbitmq de
# docker compose. Son valores de desarrollo local, no secretos reales.
# Los archivos .env.* están en .gitignore (salvo este ejemplo).

ENVIRONMENT=dev
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

PORT=3200
REQUEST_TIMEOUT=5s
MAX_BODY_BYTES=65536

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eventflow
DB_SSL_MODE=disable

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

WORKER_PORT=3201
WORKER_CONCURRENCY=4
RETRY_MAX_ATTEMPTS=4
RETRY_INITIAL_BACKOFF=500ms
NOTIFIER_FAILURE_RATE=0.3
